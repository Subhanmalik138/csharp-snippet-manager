<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>snippetvault</AssemblyName>
    <RootNamespace>SnippetVault</RootNamespace>
    <Version>1.0.0</Version>
    <Description>A CLI code snippet manager with full-text search, tags, favorites, and JSON import/export.</Description>
  </PropertyGroup>

</Project>
